#!/bin/bash
set -e
# TCP rather than a Unix socket because AppArmor socket-address mediation denies
# an AF_UNIX pathname bind() under strict confinement. --bind 127.0.0.1 is what
# keeps it off the network, which is why protected-mode can be disabled.
mkdir -p "$SNAP_COMMON/redis"
exec "$SNAP/usr/bin/redis-server" \
  --bind 127.0.0.1 \
  --port 6379 \
  --protected-mode no \
  --dir "$SNAP_COMMON/redis" \
  --save "" \
  --daemonize no
